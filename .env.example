# Attendance AI runtime configuration
# Copy this file to .env and replace placeholder values where appropriate.

# Security & authentication
# Secret used to sign PyJWT access tokens. Replace with a secure random value in production.
SECRET_KEY=change-this-in-production-to-a-secure-random-64-char-string
# Access token lifetime in minutes (480 minutes = 8 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# SQLite database path, resolved relative to backend/app/ by the application.
DATABASE_URL=sqlite:///../data/attendance.db

# Streamlit & networking
# Base URL for the FastAPI backend.
API_URL=http://127.0.0.1:8000
# Comma-separated allowed browser origins for the Streamlit frontend.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Computer vision & recognition
# Minimum ArcFace cosine similarity for frontal face matches (range: 0 to 1).
MATCH_THRESHOLD=0.60
# Minimum ArcFace cosine similarity for profile/side face matches (range: 0 to 1).
SIDE_MATCH_THRESHOLD=0.55
# SCRFD detector input dimension in pixels; 320 means 320x320.
DET_SIZE=320
# Maximum accepted image upload size in megabytes (MB).
MAX_UPLOAD_MB=5
